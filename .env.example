FLASK_ENV=development
SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=

DATABASE_URL=mysql+pymysql://autoflow:troque-esta-senha@localhost/autoflow?charset=utf8mb4
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1

REDIS_URL=redis://:troque-esta-senha@localhost:6379/0
REDIS_PASSWORD=
RATELIMIT_STORAGE_URI=
OUTBOX_IMMEDIATE_DISPATCH=true
OUTBOX_DISPATCH_INTERVAL_SECONDS=10
OUTBOX_BATCH_SIZE=100
AI_INBOUND_HOURLY_LIMIT=300
AI_SENDER_MINUTE_LIMIT=30

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_REQUEST_TIMEOUT=25
# Use uma URL acessível pela Evolution. No Compose combinado, ela é
# sobrescrita automaticamente para http://web:5000/webhooks/evolution.
EVOLUTION_WEBHOOK_URL=http://localhost:5000/webhooks/evolution

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
MAIL_FROM=AutoFlow <no-reply@example.com>

APP_URL=http://localhost:5000
APP_BIND_HOST=127.0.0.1
APP_PORT=5000
PRODUCT_UPLOAD_DIR=
PRODUCT_UPLOAD_URL_PREFIX=/products/uploads
LANDING_PAGE_URL=
CORS_ORIGINS=http://localhost:5000
TRUSTED_HOSTS=
TRUST_PROXY_HOPS=0
LOG_LEVEL=INFO
