# Copy to .env.evolution. This file is intentionally ignored by Git.
# Generate values with a password manager. Do not reuse the example values.

# Published address of Evolution. Keep localhost for local development; use the
# HTTPS public URL when Evolution is placed behind a reverse proxy in production.
SERVER_URL=http://localhost:8080
CORS_ORIGIN=*

# Evolution REST API. Send it only in the apikey header; do not expose it in the UI.
AUTHENTICATION_API_KEY=replace-with-a-long-random-api-key

# PostgreSQL backing Evolution API. The connection URI must contain the same
# credentials and therefore its password must be URL-encoded when it has reserved characters.
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DATABASE_CONNECTION_URI=postgresql://evolution:replace-with-a-url-encoded-postgres-password@evolution-postgres:5432/evolution?schema=public

# Redis backing Evolution API. This password must be URL-encoded in CACHE_REDIS_URI.
EVOLUTION_REDIS_PASSWORD=replace-with-a-long-random-redis-password
CACHE_REDIS_URI=redis://:replace-with-a-url-encoded-redis-password@evolution-redis:6379/6
